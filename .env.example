OPENROUTER_API_KEY=
# =========================
# APP
# =========================
PORT=3000
NODE_ENV=development

# =========================
# DATABASE (PostgreSQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=smart_trip_plan

# =========================
# TYPEORM
# =========================
TYPEORM_SYNC=true
TYPEORM_LOGGING=true

# =========================
# JWT
# =========================
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# =========================
# OPENROUTER AI
# =========================

OPENROUTER_MODEL=openrouter/free

# =========================
# FRONTEND
# =========================
FRONTEND_URL=http://localhost:5173

# =========================
# FILE UPLOADS
# =========================
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# =========================
# OPTIONAL CLOUDINARY
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY =